{
  "name": "my-nest-api",
  "private": true,
  "packageManager": "npm@10.9.0",
  "type": "module",
  "engines": {
    "node": "~26.8.0"
  },
  "scripts": {
    "build": "nest build",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:seed": "node dist/src/dal/seed.js",
